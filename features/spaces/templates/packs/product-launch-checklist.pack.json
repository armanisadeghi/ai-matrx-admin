    "tables": [
      {
        "token": "launch",
        "name": "Launches",
        "labelSingular": "Launch",
        "labelPlural": "Launches",
        "type": "entity",
        "display": "list",
        "weight": "light",
        "ordered": false,
        "icon": "rocket",
        "titleField": "launch_name",
        "describes": "Each product launch, its date and how far along it is.",
        "subject": "thing",
        "fields": [
          {
            "key": "launch_name",
            "label": "Launch",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "launch_on",
            "label": "Launch date",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "status",
            "label": "Status",
            "parityType": "status",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Planning",
              "On track",
              "At risk",
              "Launched"
            ],
            "choiceColors": {
              "Planning": "slate",
              "On track": "green",
              "At risk": "amber",
              "Launched": "violet"
            },
            "statusGroups": {
              "Planning": "todo",
              "On track": "in_progress",
              "At risk": "in_progress",
              "Launched": "in_progress"
            }
          },
          {
            "key": "owner",
            "label": "Owner",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "team_member",
            "relationMax": 1
          },
          {
            "key": "budget",
            "label": "Budget",
            "parityType": "currency",
            "sensitivity": "confidential",
            "contextPolicy": "include",
            "unit": "USD",
            "format": "currency",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 500000
              }
            ]
          },
          {
            "key": "task_total",
            "label": "Tasks in total",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "tasks",
            "pick": "task_name",
            "agg": "count"
          },
          {
            "key": "task_done",
            "label": "Tasks done",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "tasks",
            "pick": "task_name",
            "agg": "count",
            "filter": {
              "done": true
            }
          },
          {
            "key": "open_tasks",
            "label": "Tasks left",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "{Tasks in total} - {Tasks done}"
          },
          {
            "key": "progress",
            "label": "Launch progress (%)",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Tasks in total} > 0, ROUND({Tasks done} / {Tasks in total} * 100, 0), 0)"
          },
          {
            "key": "days_to",
            "label": "Days to launch",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "DATEDIFF(TODAY(), {Launch date}, 'days')"
          },
          {
            "key": "readiness",
            "label": "Readiness",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Launch date} < TODAY(), \"Launched\", IF(AND({Launch progress (%)} >= 50, {Days to launch} >= 14), \"Healthy\", IF({Launch progress (%)} >= 80, \"Healthy\", \"Needs attention\")))"
          }
        ],
        "rows": [
