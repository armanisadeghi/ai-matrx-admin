            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Card",
              "Bank transfer",
              "Wallet",
              "Cash"
            ],
            "choiceColors": {
              "Card": "blue",
              "Bank transfer": "violet",
              "Wallet": "teal",
              "Cash": "orange"
            }
          },
          {
            "key": "status",
            "label": "Status",
            "parityType": "status",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Active",
              "Paused",
              "Cancelled"
            ],
            "choiceColors": {
              "Active": "green",
              "Paused": "amber",
              "Cancelled": "red"
            },
            "statusGroups": {
              "Active": "in_progress",
              "Paused": "todo",
