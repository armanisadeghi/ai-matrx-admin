        "fields": [
          {
            "key": "sub_name",
            "label": "Subscription",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "cost",
            "label": "Cost",
            "parityType": "currency",
            "sensitivity": "confidential",
            "contextPolicy": "include",
            "unit": "USD",
            "format": "currency",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 5000
              }
            ]
          },
          {
            "key": "cycle",
            "label": "Billing cycle",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Weekly",
              "Monthly",
              "Quarterly",
              "Bi-yearly",
              "Yearly"
            ],
            "choiceColors": {
              "Weekly": "pink",
              "Monthly": "blue",
              "Quarterly": "teal",
              "Bi-yearly": "orange",
              "Yearly": "violet"
            }
          },
          {
            "key": "monthly_cost",
            "label": "Monthly cost",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "ROUND(SWITCH({Billing cycle}, 'Weekly', {Cost} * 52 / 12, 'Monthly', {Cost}, 'Quarterly', {Cost} / 3, 'Bi-yearly', {Cost} / 6, 'Yearly', {Cost} / 12, 0), 2)",
            "unit": "USD"
          },
          {
            "key": "yearly_cost",
            "label": "Yearly cost",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "ROUND(SWITCH({Billing cycle}, 'Weekly', {Cost} * 52, 'Monthly', {Cost} * 12, 'Quarterly', {Cost} * 4, 'Bi-yearly', {Cost} * 2, 'Yearly', {Cost}, 0), 2)",
            "unit": "USD"
          },
          {
            "key": "next_renewal",
            "label": "Next renewal",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "days_left",
            "label": "Days until renewal",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "DATEDIFF(TODAY(), {Next renewal}, 'days')"
          },
          {
            "key": "renew_state",
            "label": "Renewal state",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Status} = \"Cancelled\", \"Cancelled\", IF(DATEDIFF(TODAY(), {Next renewal}, \"days\") < 0, \"Overdue\", IF(DATEDIFF(TODAY(), {Next renewal}, \"days\") <= 7, \"Renews within a week\", IF(DATEDIFF(TODAY(), {Next renewal}, \"days\") <= 30, \"Renews within a month\", \"Later\"))))"
          },
          {
            "key": "category",
            "label": "Category",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Software",
              "Media",
              "Health",
              "Cloud",
              "Other"
            ],
            "choiceColors": {
              "Software": "blue",
              "Media": "violet",
              "Health": "teal",
              "Cloud": "orange",
              "Other": "pink"
            }
          },
          {
            "key": "payment",
