      "rules": [
       {
        "kind": "min",
        "value": 0
       },
       {
        "kind": "max",
        "value": 100000
       }
      ]
     },
     {
      "key": "total",
      "label": "Total",
      "parityType": "formula",
      "sensitivity": "internal",
      "contextPolicy": "include",
      "formula": "{Amount} + {Tax}",
      "unit": "USD"
     },
     {
      "key": "status",
      "label": "Status",
      "parityType": "select",
      "sensitivity": "internal",
      "contextPolicy": "include",
      "choices": [
       "Draft",
       "Sent",
       "Paid",
       "Overdue",
       "Void"
      ],
      "choiceColors": {
       "Draft": "slate",
       "Sent": "blue",
       "Paid": "green",
       "Overdue": "red",
       "Void": "gray"
      }
     },
     {
      "key": "overdue_flag",
      "label": "Past due",
      "parityType": "formula",
      "sensitivity": "internal",
      "contextPolicy": "include",
      "formula": "IF(AND(IS_BEFORE({Due date}, TODAY()), NOT({Status} = 'Paid'), NOT({Status} = 'Void')), 'Past due', '')"
     },
     {
      "key": "paid_on",
      "label": "Paid on",
      "parityType": "datetime",
      "sensitivity": "internal",
      "contextPolicy": "include",
      "format": "date"
     },
     {
      "key": "invoice_file",
      "label": "Invoice file",
      "parityType": "attachment",
      "sensitivity": "internal",
      "contextPolicy": "include"
