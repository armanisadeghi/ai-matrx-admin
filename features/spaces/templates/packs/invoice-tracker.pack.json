          },
          {
            "key": "paid_pct",
            "label": "Paid (% of billed)",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Billed total} > 0, ROUND({Paid total} / {Billed total} * 100, 0), 0)"
