            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "invoices",
            "pick": "memo",
            "agg": "count",
            "filter": {
              "status": [
                "Sent",
                "Paid",
                "Overdue"
              ]
