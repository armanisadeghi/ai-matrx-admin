          {
            "key": "amount",
            "label": "Amount",
            "parityType": "currency",
            "sensitivity": "confidential",
            "contextPolicy": "include",
            "unit": "USD",
            "format": "currency",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 500000
              }
            ]
          },
          {
            "key": "tax",
            "label": "Tax",
            "parityType": "currency",
            "sensitivity": "confidential",
            "contextPolicy": "include",
            "unit": "USD",
            "format": "currency",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 100000
              }
            ]
          },
          {
            "key": "total",
            "label": "Total",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "{Amount} + {Tax}",
            "unit": "USD"
          },
          {
            "key": "status",
            "label": "Status",
            "parityType": "status",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Draft",
              "Sent",
              "Paid",
              "Overdue",
              "Void"
            ],
            "choiceColors": {
              "Draft": "slate",
              "Sent": "blue",
              "Paid": "green",
              "Overdue": "red",
              "Void": "gray"
            },
            "statusGroups": {
              "Draft": "todo",
              "Sent": "in_progress",
              "Paid": "done",
              "Overdue": "in_progress",
              "Void": "done"
            }
          },
          {
            "key": "overdue_flag",
            "label": "Past due",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF(AND(IS_BEFORE({Due date}, TODAY()), NOT({Status} = 'Paid'), NOT({Status} = 'Void')), 'Past due', '')"
          },
          {
            "key": "days_late",
            "label": "Days late",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF(AND({Due date} < TODAY(), {Status} != \"Paid\", {Status} != \"Void\"), DATEDIFF({Due date}, TODAY(), \"days\"), 0)"
          },
          {
            "key": "paid_on",
            "label": "Paid on",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "invoice_file",
            "label": "Invoice file",
            "parityType": "attachment",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
