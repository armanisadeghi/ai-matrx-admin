          {
            "name": "New task",
            "values": {
              "status": "Not started"
            },
            "default": true,
            "body": {
              "v": 1,
              "blocks": [
                {
                  "type": "heading",
                  "text": [
                    {
                      "text": "What needs to happen"
                    }
                  ],
                  "props": {
                    "level": 2
                  }
                },
                {
                  "type": "text",
                  "text": [
                    {
                      "text": "Write the task as a verb: \"Call the plumber\", not \"Plumber\"."
                    }
                  ]
                },
                {
                  "type": "heading",
                  "text": [
                    {
                      "text": "Details"
                    }
                  ],
                  "props": {
                    "level": 2
                  }
                },
                {
                  "type": "bulleted",
                  "text": [
                    {
                      "text": "Who is involved"
                    }
                  ]
                },
                {
                  "type": "bulleted",
                  "text": [
                    {
                      "text": "Where it happens (the context)"
                    }
                  ]
                },
                {
                  "type": "bulleted",
                  "text": [
                    {
                      "text": "What you need before starting"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "text": [
                    {
                      "text": "Done when"
                    }
                  ],
                  "props": {
                    "level": 2
                  }
                },
                {
                  "type": "todo",
                  "text": [
                    {
                      "text": "The result you can point to"
                    }
                  ],
                  "props": {
                    "checked": false
                  }
                }
              ]
            }
