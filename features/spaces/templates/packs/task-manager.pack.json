      {
        "token": "task_priority",
        "name": "By priority",
        "table": "task",
        "kind": "kanban",
        "groupBy": "priority"
      },
      {
        "token": "all_contexts",
        "name": "Contexts",
        "table": "context",
        "kind": "grid",
        "isDefault": true
      },
      {
        "token": "task_today",
        "name": "Today",
        "table": "task",
        "kind": "grid",
        "within": {
          "due_on": {
            "relative": "today"
          }
        },
        "filters": {
          "done": false
        }
      },
      {
        "token": "task_overdue",
        "name": "Overdue",
        "table": "task",
        "kind": "grid",
        "within": {
          "due_on": {
            "relative": "before_today"
          }
        },
        "filters": {
          "done": false
        }
      },
      {
        "token": "task_next7",
        "name": "Next 7 days",
        "table": "task",
        "kind": "grid",
        "within": {
          "due_on": {
            "relative": "next_days",
            "n": 7
          }
        },
        "filters": {
          "done": false
        }
      },
      {
        "token": "task_week",
        "name": "This week",
        "table": "task",
        "kind": "calendar",
        "dateField": "due_on",
        "within": {
          "due_on": {
            "relative": "this_week"
          }
        }
      },
      {
        "token": "task_mine",
        "name": "My tasks",
        "table": "task",
        "kind": "grid",
        "me": [
          "assignee"
        ]
      }
    ],
    "agent": {
      "platformAgent": {
        "id": "4cd676c6-f55d-4426-b7eb-a9d0273566ec",
        "name": "Answers From Your Tables"
      },
      "name": "Assistant",
      "variables": [
        {
          "name": "primary_table",
          "table": "task",
          "describes": "Every task, its status and priority."
        },
        {
          "name": "related_tables",
          "table": "context",
          "describes": "Where each task gets done."
        }
      ],
      "question": {
        "ask": "How many tasks are done?",
        "whyItMatters": "Dev checks the done count at the end of the week.",
        "expect": {
          "table": "task",
          "measure": {
            "op": "count"
          },
          "filter": {
            "status": "Done"
          },
          "answer": 4,
          "unit": "tasks"
        }
      }
    },
    "walk": [
      {
        "says": "Open the task board.",
        "action": {
          "kind": "open",
          "surface": "task_board"
        },
        "expect": {
          "kind": "renders",
          "surface": "task_board",
          "minItems": 12
        }
      },
      {
        "says": "Open the task calendar.",
        "action": {
          "kind": "open",
          "surface": "task_calendar"
        },
        "expect": {
          "kind": "renders",
          "surface": "task_calendar",
          "minItems": 12
        }
      },
      {
        "says": "Open tasks by priority.",
        "action": {
          "kind": "open",
          "surface": "task_priority"
        },
        "expect": {
          "kind": "renders",
          "surface": "task_priority",
          "minItems": 12
        }
      }
    ],
