  "spec": {
    "specVersion": 1,
    "id": "spaces-personal-to-do-list",
    "catalogueId": "SP0201",
    "useCase": "Dev Ramanathan collects every small errand and chore in one place and works through it by context.",
    "industry": "cross_industry",
    "vertical": "Personal task management",
    "job": "projects",
    "audience": "individual",
    "teaches": "boards",
    "strengths": [],
    "requires": [],
    "business": {
      "name": "Personal workspace",
      "describes": "A private personal workspace for one person.",
      "address": {
        "line1": "41 Marrow Lane",
        "city": "Portland",
        "region": "OR",
        "postalCode": "97214",
        "country": "US"
      },
      "phone": "(503) 555-0148",
      "website": "lifeledger.net",
      "email": "hello@lifeledger.net",
      "timezone": "America/Los_Angeles"
    },
    "cleanupTag": "use-case:spaces-task-manager",
    "tables": [
      {
        "token": "context",
        "name": "Contexts",
        "labelSingular": "Context",
        "labelPlural": "Contexts",
        "type": "entity",
        "display": "grid",
        "weight": "light",
        "ordered": false,
        "icon": "map-pin",
        "titleField": "context_name",
        "describes": "Where or how a task gets done, so you can batch similar work.",
        "subject": "thing",
        "fields": [
          {
            "key": "context_name",
            "label": "Context",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "where",
            "label": "Where it happens",
            "parityType": "text",
            "sensitivity": "confidential",
            "contextPolicy": "include"
          },
          {
            "key": "best_time",
            "label": "Best time",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "open_tasks",
            "label": "Open tasks",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "tasks",
            "pick": "task_name",
            "agg": "count",
            "filter": {
              "done": false
            }
          }
        ],
        "rows": [
          {
            "key": "c-home",
            "values": {
              "context_name": "At home",
              "where": "Chores and tasks that need the house",
              "best_time": "Evenings and weekends"
            }
          },
          {
            "key": "c-errand",
            "values": {
              "context_name": "Errands",
              "where": "Anything that needs a trip out",
              "best_time": "Saturday mornings"
            }
          },
          {
            "key": "c-desk",
            "values": {
              "context_name": "At the computer",
              "where": "Online forms, email and research",
              "best_time": "Weekday mornings"
            }
          },
          {
            "key": "c-phone",
            "values": {
              "context_name": "Calls",
              "where": "People or companies to ring",
              "best_time": "Lunch breaks"
            }
          }
        ]
      },
      {
        "token": "task",
        "name": "Tasks",
        "labelSingular": "Task",
        "labelPlural": "Tasks",
        "type": "entity",
        "display": "grid",
        "weight": "light",
        "ordered": false,
        "icon": "list-checks",
        "titleField": "task_name",
        "describes": "Every to-do with its due day, priority and where it gets done.",
        "subject": "thing",
        "independentOf": {
          "context": "A task can be done in any context on any day."
        },
        "fields": [
          {
            "key": "task_name",
            "label": "Task",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "status",
            "label": "Status",
            "parityType": "status",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Not started",
              "In progress",
              "Done"
            ],
            "choiceColors": {
              "Not started": "slate",
              "In progress": "blue",
              "Done": "green"
            },
            "default": "Not started",
            "statusGroups": {
              "Not started": "todo",
              "In progress": "in_progress",
              "Done": "done"
            }
          },
          {
            "key": "priority",
            "label": "Priority",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Low",
              "Medium",
              "High",
              "Urgent"
            ],
            "choiceColors": {
              "Low": "slate",
              "Medium": "blue",
              "High": "green",
              "Urgent": "amber"
            }
          },
          {
            "key": "category",
            "label": "Category",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Home",
              "Work",
              "Admin",
              "Health",
              "Family"
            ],
            "choiceColors": {
              "Home": "slate",
              "Work": "blue",
              "Admin": "green",
              "Health": "amber",
              "Family": "red"
            }
          },
          {
            "key": "context",
            "label": "Context",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "context",
            "relationMax": 1
          },
          {
            "key": "assignee",
            "label": "Assigned to",
            "parityType": "member",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "due_on",
            "label": "Due",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "completed_on",
            "label": "Completed on",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "done",
            "label": "Done",
            "parityType": "checkbox",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "repeats",
            "label": "Repeats",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Never",
              "Weekly",
              "Monthly",
              "Yearly"
            ],
            "choiceColors": {
              "Never": "slate",
              "Weekly": "blue",
              "Monthly": "green",
              "Yearly": "amber"
            }
          },
          {
            "key": "minutes",
            "label": "Estimate (min)",
            "parityType": "integer",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 600
              }
            ]
          },
          {
            "key": "notes",
            "label": "Notes",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "days_left",
            "label": "Days until due",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "DATEDIFF(TODAY(), {Due}, 'days')",
            "source": "formula",
            "computeOn": "read"
          },
          {
            "key": "due_flag",
            "label": "Due flag",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Done} = TRUE, \"\", IF(DATEDIFF(TODAY(), {Due}, 'days') < 0, \"Overdue\", IF(DATEDIFF(TODAY(), {Due}, 'days') <= 2, \"Due soon\", \"\")))"
          },
          {
            "key": "created",
            "label": "Created",
            "parityType": "created_time",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "edited",
            "label": "Last edited",
            "parityType": "modified_time",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "finish_btn",
            "label": "Mark done",
            "parityType": "button",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "button": {
              "do": "run_action",
              "action": "task_finish"
            }
          },
          {
            "key": "take_btn",
            "label": "Assign to me",
            "parityType": "button",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "button": {
              "do": "run_action",
              "action": "task_take"
            }
          }
        ],
