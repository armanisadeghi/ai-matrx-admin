    "relationships": [
      {
        "describes": "Each task has one context.",
        "fromTable": "task",
        "fromField": "context",
        "toTable": "context",
        "flavor": "referenced",
        "cardinality": "one",
        "onDelete": "set_null",
        "inverseKey": "tasks"
      }
    ],
    "sharedBlocks": [],
    "forms": [
      {
        "token": "add_task",
        "name": "Add a task",
        "describes": "Capture something to do.",
        "audience": "staff",
        "table": "task",
        "fields": [
          {
            "fieldKey": "task_name",
            "ask": "What is the task?",
            "required": true
          },
          {
            "fieldKey": "due_on",
            "ask": "When is it due?"
          },
          {
            "fieldKey": "priority",
            "ask": "How important is it?"
          },
          {
            "fieldKey": "category",
            "ask": "What kind of task?"
          }
        ],
        "submitLabel": "Add task",
        "confirmation": "Added to your list."
      }
    ],
    "dimensions": [],
    "extras": [
      {
        "kind": "row_action",
        "token": "task_finish",
        "table": "task",
        "name": "Mark done",
        "actionKind": "update",
        "steps": [
          {
            "field": "done",
            "set": "value",
            "value": true
          },
          {
            "field": "status",
            "set": "value",
            "value": "Done"
          },
          {
            "field": "completed_on",
            "set": "value",
            "value": "@today"
          }
        ],
        "color": "green"
      },
      {
        "kind": "row_action",
        "token": "task_take",
        "table": "task",
        "name": "Assign to me",
        "actionKind": "update",
        "steps": [
          {
            "field": "assignee",
            "set": "value",
            "value": "@me"
          }
        ]
      }
    ],
    "views": [
      {
        "token": "all_tasks",
        "name": "All tasks",
        "table": "task",
        "kind": "grid",
        "isDefault": true,
        "sorts": [
          {
            "field": "due_on",
            "direction": "asc"
          }
        ]
      },
      {
        "token": "task_board",
        "name": "By status",
        "table": "task",
        "kind": "kanban",
        "groupBy": "status"
      },
      {
        "token": "task_calendar",
        "name": "Calendar",
