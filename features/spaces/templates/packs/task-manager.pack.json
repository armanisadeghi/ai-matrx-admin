          {
            "key": "status",
            "label": "Status",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Not started",
              "In progress",
              "Done"
            ],
            "choiceColors": {
              "Not started": "slate",
              "In progress": "blue",
              "Done": "green"
            },
            "default": "Not started"
          },
          {
            "key": "priority",
            "label": "Priority",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Low",
              "Medium",
              "High",
              "Urgent"
            ],
            "choiceColors": {
              "Low": "slate",
              "Medium": "blue",
              "High": "green",
              "Urgent": "amber"
            }
          },
          {
            "key": "category",
            "label": "Category",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Home",
              "Work",
              "Admin",
              "Health",
              "Family"
            ],
            "choiceColors": {
              "Home": "slate",
              "Work": "blue",
              "Admin": "green",
              "Health": "amber",
              "Family": "red"
            }
          },
          {
            "key": "context",
            "label": "Context",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "context",
            "relationMax": 1
          },
          {
            "key": "due_on",
            "label": "Due",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "done",
            "label": "Done",
            "parityType": "checkbox",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "repeats",
            "label": "Repeats",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Never",
              "Weekly",
              "Monthly",
              "Yearly"
            ],
            "choiceColors": {
              "Never": "slate",
              "Weekly": "blue",
              "Monthly": "green",
              "Yearly": "amber"
            }
          },
          {
            "key": "minutes",
            "label": "Minutes needed",
            "parityType": "integer",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 600
              }
            ]
          },
          {
            "key": "notes",
            "label": "Notes",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "days_left",
            "label": "Days until due",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "DATEDIFF(TODAY(), {Due}, 'days')",
            "source": "formula",
            "computeOn": "read"
          }
        ],
