    {
      "key": "triage-guide",
      "parent": "task-manager",
      "title": "Triage guide",
      "icon": {
        "emoji": "🧭"
      },
      "blocks": [
        {
          "type": "text",
          "text": [
            {
              "text": "When the list gets long, run it through these questions in order."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Does it take under two minutes? Do it now."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Does it have a hard day? Give it a due date."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Can someone else do it? Note who and when to check."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Is it a someday idea? Move it out of this list."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Otherwise pick a context and a priority."
            }
          ]
        },
        {
          "type": "callout",
          "text": [
            {
              "text": "A short list you trust beats a long list you avoid."
            }
          ],
          "background": "yellow",
          "props": {
            "icon": "Sparkles"
          }
        },
        {
          "type": "table",
          "props": {
            "headerRow": true,
            "headerColumn": false,
            "rows": [
              {
                "cells": [
