  {
   "key": "write-a-sop",
   "parent": "sop-library",
   "title": "How to write an SOP",
   "icon": {
    "emoji": "✍️"
   },
   "settings": {
    "fullWidth": true
   },
   "blocks": [
    {
     "type": "numbered",
     "text": [
      {
       "text": "State the purpose in one sentence."
      }
     ]
    },
    {
     "type": "numbered",
     "text": [
      {
       "text": "List who it applies to and who is responsible."
      }
     ]
    },
    {
     "type": "numbered",
     "text": [
      {
       "text": "Write numbered steps. One action per step."
      }
     ]
    },
    {
     "type": "numbered",
     "text": [
      {
       "text": "Add a checklist for anything that must not be missed."
      }
     ]
    },
    {
     "type": "numbered",
     "text": [
      {
       "text": "Say what to do when it goes wrong."
      }
     ]
    },
    {
     "type": "numbered",
     "text": [
      {
       "text": "Record the version and a short change note."
      }
     ]
    },
    {
     "type": "callout",
     "text": [
      {
       "text": "If a new hire cannot follow it without asking questions, it is not finished."
      }
     ],
     "background": "yellow",
     "props": {
      "icon": "HelpCircle"
     }
    }
   ]
  },
