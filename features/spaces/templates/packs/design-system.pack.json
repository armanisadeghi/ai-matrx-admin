    },
    {
     "type": "numbered",
     "text": [
      {
       "text": "Flexible: tokens, not hard-coded values."
      }
     ]
    },
    {
     "type": "quote",
     "text": [
      {
       "text": "If a component needs a special case, the system is missing a variant."
      }
     ]
