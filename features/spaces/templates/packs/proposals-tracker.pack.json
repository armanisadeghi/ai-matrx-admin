          },
          {
            "key": "status",
            "label": "Status",
            "parityType": "status",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Drafting",
              "Sent",
              "Viewed",
              "Negotiating",
              "Accepted",
              "Declined",
              "Expired"
            ],
            "choiceColors": {
              "Drafting": "blue",
              "Sent": "amber",
              "Viewed": "violet",
              "Negotiating": "teal",
              "Accepted": "green",
              "Declined": "red",
              "Expired": "slate"
            },
            "required": true,
            "default": "Drafting",
            "statusGroups": {
              "Drafting": "todo",
              "Sent": "in_progress",
              "Viewed": "in_progress",
              "Negotiating": "in_progress",
              "Accepted": "done",
              "Declined": "done",
              "Expired": "done"
            }
          },
          {
            "key": "value",
            "label": "Value",
            "parityType": "currency",
            "sensitivity": "confidential",
            "contextPolicy": "include",
            "unit": "USD",
            "format": "currency",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 500000
              }
            ]
          },
          {
            "key": "sent_on",
            "label": "Sent",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "valid_until",
            "label": "Valid until",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "decided_on",
            "label": "Decided on",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "days_left",
            "label": "Days left",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "DATEDIFF(TODAY(), {Valid until}, 'days')"
          },
          {
            "key": "owner",
            "label": "Owner",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "team_member",
