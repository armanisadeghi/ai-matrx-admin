    {
      "key": "brand-guidelines",
      "parent": "brand-assets-hub",
      "title": "Brand guidelines",
      "icon": {
        "emoji": "📘"
      },
      "settings": {
        "fullWidth": true
      },
      "blocks": [
        {
          "type": "heading",
          "text": [
            {
              "text": "Voice"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Plain, warm and direct"
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Short sentences, active verbs"
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Say what we do before we say how well"
            }
          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "Do"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Use real project photos"
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Keep generous white space"
            }
          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "Do not"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Add shadows or outlines to the logo"
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Use colors outside the palette"
            }
          ]
        }
      ]
    },
    {
      "key": "logo-usage",
      "parent": "brand-assets-hub",
      "title": "Logo usage",
      "icon": {
        "emoji": "🔖"
      },
      "settings": {
        "fullWidth": true
      },
      "blocks": [
        {
          "type": "heading",
          "text": [
            {
              "text": "Using the logo well"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Use the full-colour logo on light backgrounds and the white logo on dark photos or brand colours."
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Never stretch, rotate, recolour or add effects. If it does not fit, use the compact mark."
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Keep the minimum size: wide logo 120 pixels or 30 millimetres across; compact mark 24 pixels."
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Co-brand with equal height and a clear gap between the two logos."
            }
          ]
        },
        {
          "type": "callout",
          "text": [
            {
              "text": "If someone asks for a version that does not exist, add a request to the Asset request process instead of editing the file."
            }
          ],
          "background": "blue",
          "props": {
            "icon": "BadgeCheck"
          }
        },
        {
