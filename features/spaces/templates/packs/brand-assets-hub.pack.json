    {
      "key": "color-and-type",
      "parent": "brand-assets-hub",
      "title": "Color and type",
      "icon": {
        "emoji": "🌈"
      },
      "settings": {
        "fullWidth": true
      },
      "blocks": [
        {
          "type": "heading",
          "text": [
            {
              "text": "Putting colour and type to work"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Use the primary colour for large areas such as headers and buttons. Accents are for small highlights."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Check contrast: body text needs at least a 4.5 to 1 ratio against its background."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Set headings in the brand heading font and everything else in the body font. Never mix in a third family."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "When you add a new colour to a design, add it here first."
            }
          ]
        },
        {
          "type": "database",
          "props": {
            "source": {
              "kind": "template",
              "table": "brand",
              "view": "all_brands"
            },
            "inline": true,
            "title": "Brands",
            "linked": true,
            "showTitle": false,
            "views": [
