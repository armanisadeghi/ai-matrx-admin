            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "plan_list",
            "pick": "topic",
            "agg": "count",
            "filter": {
              "done": true
            }
          },
          {
            "key": "minutes_planned",
            "label": "Minutes planned",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
