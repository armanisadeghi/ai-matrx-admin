          },
          {
            "key": "room",
            "label": "Room",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "room",
            "relationMax": 1
          },
          {
            "key": "category",
            "label": "Category",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Furniture",
              "Electronics",
              "Appliance",
              "Cookware",
              "Decor",
              "Tools",
              "Sports"
