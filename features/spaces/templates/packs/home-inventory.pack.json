      {
        "token": "room",
        "name": "Rooms",
        "labelSingular": "Room",
        "labelPlural": "Rooms",
        "type": "entity",
        "display": "grid",
        "weight": "light",
        "ordered": false,
        "icon": "door-open",
        "titleField": "room_name",
        "describes": "Each room with how many things are in it and what they are worth.",
        "subject": "thing",
        "fields": [
          {
            "key": "room_name",
            "label": "Room",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "floor",
            "label": "Floor",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Ground floor",
              "Upstairs"
            ],
            "choiceColors": {
              "Ground floor": "slate",
              "Upstairs": "blue"
            }
          },
          {
            "key": "purpose",
            "label": "Purpose",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "area_sqft",
            "label": "Area (sq ft)",
            "parityType": "integer",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "rules": [
              {
                "kind": "min",
                "value": 10
              },
              {
                "kind": "max",
                "value": 2000
              }
            ]
          },
          {
            "key": "last_photographed",
            "label": "Last photographed",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "item_count",
            "label": "Items",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "items",
            "pick": "item_name",
            "agg": "count"
          },
          {
            "key": "total_value",
            "label": "Total value",
            "parityType": "rollup",
            "sensitivity": "confidential",
            "contextPolicy": "include",
            "via": "items",
            "pick": "current_value",
            "agg": "sum",
            "unit": "USD",
            "format": "currency"
          },
          {
            "key": "avg_value",
            "label": "Average item value",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Items} > 0, ROUND({Total value} / {Items}, 0), 0)"
          }
        ],
        "rows": [
