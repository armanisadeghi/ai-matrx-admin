          {
            "key": "brand",
            "label": "Brand",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "model",
            "label": "Model",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "serial",
            "label": "Serial number",
            "parityType": "text",
            "sensitivity": "confidential",
            "contextPolicy": "include"
          },
          {
            "key": "purchased_on",
            "label": "Purchased",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "price",
            "label": "Purchase price",
            "parityType": "currency",
            "sensitivity": "confidential",
            "contextPolicy": "include",
            "unit": "USD",
            "format": "currency",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 50000
              }
            ]
          },
          {
            "key": "current_value",
            "label": "Current value",
            "parityType": "currency",
            "sensitivity": "confidential",
            "contextPolicy": "include",
            "unit": "USD",
            "format": "currency",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 50000
              }
            ]
          },
          {
            "key": "value_change",
            "label": "Value change",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "{Current value} - {Purchase price}"
          },
          {
            "key": "warranty_ends",
            "label": "Warranty ends",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "warranty_days",
            "label": "Warranty days left",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "DATEDIFF(TODAY(), {Warranty ends}, 'days')"
          },
          {
            "key": "warranty_flag",
            "label": "Warranty",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Warranty days left} < 0, \"Expired\", IF({Warranty days left} <= 60, \"Ending soon\", \"Covered\"))"
          },
          {
            "key": "condition",
            "label": "Condition",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Excellent",
              "Good",
              "Fair",
              "Poor"
            ],
            "choiceColors": {
              "Excellent": "slate",
              "Good": "blue",
              "Fair": "green",
              "Poor": "amber"
            }
          },
          {
            "key": "location_detail",
            "label": "Where exactly",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "added",
            "label": "Added",
            "parityType": "created_time",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "edited",
            "label": "Last edited",
            "parityType": "modified_time",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "search_btn",
            "label": "Find manual",
            "parityType": "button",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "button": {
              "do": "open_url",
              "url": "https://www.google.com/search?q={{brand}}+{{model}}+manual"
            }
          }
        ],
