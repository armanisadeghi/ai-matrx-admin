    {
      "key": "triage-guide",
      "parent": "bug-tracker",
      "title": "Triage guide",
      "icon": {
        "emoji": "🩺"
      },
      "blocks": [
        {
          "type": "text",
          "text": [
            {
              "text": "Triage happens every weekday at ten. Each bug leaves the Reported column that day."
            }
          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "Severity"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "table",
          "props": {
            "headerRow": true,
            "headerColumn": false,
            "rows": [
              {
                "cells": [
                  [
                    {
                      "text": "Severity"
                    }
                  ],
                  [
                    {
                      "text": "Meaning"
                    }
                  ],
                  [
                    {
                      "text": "Fix target"
                    }
                  ]
                ]
              },
              {
                "cells": [
                  [
                    {
                      "text": "Critical"
                    }
                  ],
                  [
                    {
                      "text": "Data loss, security, or nobody can sign in"
                    }
                  ],
                  [
                    {
                      "text": "Today"
                    }
                  ]
                ]
              },
              {
                "cells": [
                  [
                    {
                      "text": "Major"
                    }
                  ],
                  [
                    {
                      "text": "A main feature is broken for many people"
                    }
                  ],
                  [
                    {
                      "text": "This week"
                    }
                  ]
                ]
              },
              {
                "cells": [
                  [
                    {
                      "text": "Minor"
                    }
                  ],
                  [
                    {
                      "text": "Something is wrong but there is a workaround"
                    }
                  ],
                  [
                    {
                      "text": "Next release"
                    }
                  ]
                ]
              },
              {
                "cells": [
                  [
                    {
                      "text": "Trivial"
                    }
                  ],
                  [
                    {
                      "text": "Cosmetic or very rare"
                    }
                  ],
                  [
                    {
                      "text": "When convenient"
                    }
                  ]
                ]
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "Priority"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "text",
          "text": [
            {
              "text": "Severity says how bad it is. Priority says when we fix it, which also depends on how many people it touches and how hard it is."
            }
          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "Steps"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Reproduce it, or ask the reporter for more."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Set severity, priority and component."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Look for a duplicate; link it and set the status to Duplicate."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Assign an owner and move it to Triaged."
            }
          ]
        },
        {
          "type": "toggle",
          "text": [
            {
              "text": "When to say Won’t fix"
            }
          ],
          "children": [
            {
              "type": "text",
              "text": [
                {
                  "text": "When the cost is far larger than the harm and the product owner agrees. Write the reason in the bug."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "bug-report-outline",
