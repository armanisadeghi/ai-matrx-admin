          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "What happened instead"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "text",
          "text": [
            {
              "text": "Include the exact message, and a screenshot if you can."
            }
          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "Where"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Environment and version"
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Browser or device"
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Account used (not the password)"
            }
          ]
        }
      ]
