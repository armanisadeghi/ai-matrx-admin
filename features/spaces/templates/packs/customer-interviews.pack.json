          "props": {
            "level": 2
          }
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Tell me about the last time this came up."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "What did you do first? What happened next?"
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "What did you try that did not work?"
            }
          ]
        },
