          {
            "key": "followup_due",
            "label": "Follow-up due",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Next follow-up} != \"\", IF(DATEDIFF(TODAY(), {Next follow-up}, 'days') <= 0, \"Due\", \"Later\"), \"None set\")"
