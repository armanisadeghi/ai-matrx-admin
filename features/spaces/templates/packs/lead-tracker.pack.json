        "table": "lead",
        "kind": "grid",
        "within": {
          "next_followup": {
            "relative": "this_week"
          }
        },
        "anyOf": {
          "status": [
            "New",
            "Contacted",
            "Qualified"
          ]
        }
      },
      {
        "token": "lead_over",
        "name": "Overdue",
        "table": "lead",
        "kind": "grid",
        "within": {
          "next_followup": {
            "relative": "before_today"
          }
        },
        "anyOf": {
          "status": [
            "New",
            "Contacted",
            "Qualified"
          ]
        }
      },
      {
        "token": "lead_next7",
