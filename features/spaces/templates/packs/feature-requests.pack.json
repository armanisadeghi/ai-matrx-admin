    "agent": {
      "platformAgent": {
        "id": "4cd676c6-f55d-4426-b7eb-a9d0273566ec",
        "name": "Answers From Your Tables"
      },
      "name": "Requests assistant",
      "variables": [
        {
          "name": "primary_table",
          "table": "request",
          "describes": "Every request with votes, status, area and owner."
        },
        {
          "name": "related_tables",
          "table": "customer",
          "describes": "Customers and their yearly value."
        }
      ],
      "question": {
        "ask": "How many requests are still new?",
        "whyItMatters": "Lena triages new ones first.",
        "expect": {
          "table": "request",
          "measure": {
            "op": "count"
          },
          "filter": {
            "status": "New"
          },
          "answer": 3,
          "unit": "requests"
        }
      }
    },
    "walk": [
      {
        "says": "Open the request board.",
        "action": {
          "kind": "open",
          "surface": "request_board"
        },
        "expect": {
          "kind": "renders",
          "surface": "request_board",
          "minItems": 10
        }
      },
      {
