    {
      "key": "triage-guide",
      "parent": "feature-requests",
      "title": "Weekly triage",
      "icon": {
        "emoji": "🧭"
      },
      "settings": {
        "fullWidth": true
      },
      "blocks": [
        {
          "type": "heading",
          "text": [
            {
              "text": "Triage in four moves"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Open Needs triage and read each request."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Merge repeats: add the customer to the existing request instead of a new row."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Set priority from votes, customers asking and ARR affected."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Move to Under review or Declined, and tell the person who asked."
            }
          ]
        },
        {
          "type": "callout",
          "text": [
            {
              "text": "Declined is a fine answer. Write one line on why, so it can be reopened if it comes up again."
            }
          ],
          "background": "gray",
          "props": {
            "icon": "MessageSquare"
          }
        }
      ]
    },
    {
      "key": "request-writing-guide",
      "parent": "feature-requests",
      "title": "Writing a good request",
      "icon": {
        "emoji": "✍️"
      },
      "settings": {
        "fullWidth": true
      },
      "blocks": [
        {
          "type": "heading",
          "text": [
            {
              "text": "What to capture"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "The problem in the customer's own words"
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "What they do today to work around it"
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Who is affected and how often"
            }
          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "A worked example"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "text",
          "text": [
            {
              "text": "Weak: \"Better reports.\" Strong: \"Our finance lead exports the usage table every Friday and rebuilds the totals by hand because the report cannot group by team. It takes about forty minutes and she does it for six accounts.\" The second version tells you the problem, the frequency and the cost without a single design idea in it."
            }
          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "Keep it separable"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "text",
          "text": [
            {
              "text": "If one request holds two problems, split it into two rows and link the same customers to both. Votes and customers asking are counted per row, so a bundled request hides which half people actually want."
            }
          ]
        },
        {
          "type": "callout",
          "text": [
            {
              "text": "Every new row opens with the Problem, Proposed solution and Impact headings already in place. Fill in the first and last; the middle one can wait."
            }
          ],
          "props": {
            "icon": "FileText"
          }
        }
      ]
    }
