            ]
          }
        ],
        "rowTemplates": [
          {
            "name": "New request",
            "values": {
              "status": "New"
            },
            "default": true,
            "body": {
              "v": 1,
              "blocks": [
                {
                  "type": "heading",
                  "text": [
                    {
                      "text": "Problem"
                    }
                  ],
                  "props": {
                    "level": 2
                  }
                },
                {
                  "type": "text",
                  "text": [
                    {
                      "text": "Describe what is hard, in the customer’s own words."
                    }
                  ]
                },
                {
                  "type": "heading",
                  "text": [
                    {
                      "text": "What they do today"
                    }
                  ],
                  "props": {
                    "level": 2
                  }
                },
                {
                  "type": "bulleted",
                  "text": [
                    {
                      "text": "The workaround, and how long it takes"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "text": [
                    {
                      "text": "Proposed solution"
                    }
                  ],
                  "props": {
                    "level": 2
                  }
                },
                {
                  "type": "text",
                  "text": [
                    {
                      "text": "What would help, in one or two sentences."
                    }
                  ]
                },
                {
                  "type": "heading",
                  "text": [
                    {
                      "text": "Impact"
                    }
                  ],
                  "props": {
                    "level": 2
                  }
                },
                {
                  "type": "bulleted",
                  "text": [
                    {
                      "text": "Who is affected and how often"
                    }
                  ]
                },
                {
                  "type": "bulleted",
                  "text": [
                    {
                      "text": "What it is worth in renewals or new deals"
                    }
                  ]
                }
              ]
            }
          }
        ]
