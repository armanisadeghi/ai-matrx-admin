  "spec": {
    "specVersion": 1,
    "id": "spaces-feature-requests",
    "catalogueId": "SP0351",
    "useCase": "Lena Okonkwo reviews what customers ask for each week and decides what to plan.",
    "industry": "cross_industry",
    "vertical": "Product management",
    "job": "projects",
    "audience": "organization",
    "teaches": "boards",
    "strengths": [],
    "requires": [],
    "business": {
      "name": "Brightvane Software",
      "describes": "A small company selling scheduling and invoicing software to service businesses.",
      "address": {
        "line1": "902 Alder Lantern Way",
        "city": "San Francisco",
        "region": "CA",
        "postalCode": "94110",
        "country": "US"
      },
      "phone": "(415) 555-0130",
      "website": "brightvane.net",
      "email": "hello@brightvane.net",
      "timezone": "America/Los_Angeles"
    },
    "cleanupTag": "use-case:spaces-feature-requests",
    "tables": [
      {
        "token": "request",
        "name": "Requests",
        "labelSingular": "Request",
        "labelPlural": "Requests",
        "type": "entity",
        "display": "board",
        "weight": "light",
        "ordered": false,
        "icon": "lightbulb",
        "titleField": "request_name",
        "describes": "Every feature request, how many people want it and where it stands.",
        "subject": "thing",
        "fields": [
          {
            "key": "request_name",
            "label": "Request",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "status",
            "label": "Status",
            "parityType": "status",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "New",
              "Under review",
              "Planned",
              "In progress",
              "Shipped",
              "Declined"
            ],
            "choiceColors": {
              "New": "slate",
              "Under review": "amber",
              "Planned": "blue",
              "In progress": "violet",
              "Shipped": "green",
              "Declined": "red"
            },
            "statusGroups": {
              "New": "todo",
              "Under review": "in_progress",
              "Planned": "in_progress",
              "In progress": "in_progress",
              "Shipped": "done",
              "Declined": "done"
            }
          },
          {
            "key": "priority",
            "label": "Priority",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Low",
              "Medium",
              "High",
              "Critical"
            ],
            "choiceColors": {
              "Low": "slate",
              "Medium": "amber",
              "High": "orange",
              "Critical": "red"
            }
          },
          {
            "key": "votes",
            "label": "Votes",
            "parityType": "integer",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 100000
              }
            ]
          },
          {
            "key": "customers",
            "label": "Asked by",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "customer",
            "relationMax": 50,
            "multi": true
          },
          {
            "key": "customer_count",
            "label": "Customers asking",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "customers",
            "pick": "customer_name",
            "agg": "count"
          },
          {
            "key": "arr_affected",
            "label": "ARR affected",
            "parityType": "rollup",
            "sensitivity": "confidential",
            "contextPolicy": "include",
            "via": "customers",
            "pick": "arr",
            "agg": "sum"
          },
          {
            "key": "demand",
            "label": "Demand score",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "{Votes} + {Customers asking} * 5 + IF({ARR affected} >= 100000, 20, IF({ARR affected} >= 25000, 10, 0))"
          },
          {
            "key": "area",
            "label": "Area",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Reporting",
              "Integrations",
              "Mobile",
              "Billing",
              "Admin",
              "Notifications"
            ],
            "choiceColors": {
              "Reporting": "blue",
              "Integrations": "green",
              "Mobile": "amber",
              "Billing": "red",
              "Admin": "violet",
              "Notifications": "teal"
            }
          },
          {
            "key": "owner",
            "label": "Owner",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "team_member",
            "relationMax": 1
          },
          {
            "key": "submitted_on",
            "label": "Submitted",
            "parityType": "created_time",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "submitted_by",
            "label": "Submitted by",
            "parityType": "created_by",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "updated_at",
            "label": "Last updated",
            "parityType": "modified_time",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "details",
            "label": "Details",
            "parityType": "long_text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "review_btn",
            "label": "Start review",
            "parityType": "button",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "button": {
              "do": "run_action",
              "action": "request_review"
            }
          },
          {
            "key": "decline_btn",
            "label": "Decline",
            "parityType": "button",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "button": {
              "do": "run_action",
              "action": "request_decline"
            }
          },
          {
            "key": "decided_on",
            "label": "Decided on",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          }
        ],
        "rows": [
          {
