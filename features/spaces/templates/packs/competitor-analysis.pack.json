          },
          {
            "key": "segment",
            "label": "Target segment",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Solo operators",
              "Small teams",
              "Mid-size firms",
              "Enterprise",
              "Startups"
            ],
            "choiceColors": {
              "Solo operators": "blue",
              "Small teams": "violet",
              "Mid-size firms": "teal",
              "Enterprise": "orange",
              "Startups": "pink"
            }
          },
          {
            "key": "threat",
            "label": "Threat level",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Low",
              "Medium",
              "High"
            ],
            "choiceColors": {
              "Low": "green",
              "Medium": "amber",
              "High": "red"
            }
          },
          {
            "key": "last_reviewed",
            "label": "Last reviewed",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "days_since",
            "label": "Days since review",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "DATEDIFF(TODAY(), {Last reviewed}, 'days')"
          },
          {
            "key": "review_flag",
            "label": "Review state",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF(DATEDIFF(TODAY(), {Last reviewed}, \"days\") > 45, \"Overdue\", IF(DATEDIFF(TODAY(), {Last reviewed}, \"days\") > 30, \"Due soon\", \"Current\"))"
          },
          {
            "key": "features_count",
            "label": "Features tracked",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "features_offered",
            "pick": "feature_name",
            "agg": "count"
          },
          {
            "key": "updated_at",
            "label": "Last updated",
            "parityType": "modified_time",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "open_website",
            "label": "Open website",
            "parityType": "button",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "button": {
              "do": "open_url",
              "url": "{{website}}"
            }
          }
        ],
