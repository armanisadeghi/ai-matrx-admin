            "via": "tasks",
            "pick": "task_name",
            "agg": "count"
          },
          {
            "key": "tasks_done",
            "label": "Tasks done",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "tasks",
            "pick": "task_name",
            "agg": "count",
            "filter": {
              "done": true
            }
          },
          {
            "key": "minutes_planned",
            "label": "Minutes planned",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "tasks",
            "pick": "minutes",
            "agg": "sum"
          },
          {
            "key": "progress",
            "label": "Progress (%)",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Tasks} > 0, ROUND({Tasks done} / {Tasks} * 100, 0), 0)"
          }
