        "fields": [
          {
            "key": "category_name",
            "label": "Category",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "monthly_budget",
            "label": "Monthly budget",
            "parityType": "currency",
            "sensitivity": "confidential",
            "contextPolicy": "include",
            "unit": "USD",
            "format": "currency",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 20000
              }
            ]
          },
          {
            "key": "group",
            "label": "Group",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Essentials",
              "Lifestyle"
            ],
            "choiceColors": {
              "Essentials": "blue",
              "Lifestyle": "green"
            }
          },
          {
            "key": "spent_total",
            "label": "Spent (all logged)",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "expenses",
            "pick": "amount",
            "agg": "sum"
          },
          {
            "key": "spent_month",
            "label": "Spent this month",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "expenses",
            "pick": "amount",
            "agg": "sum",
            "filter": {
              "spent_on": {
                "relative": "this_month"
              }
            }
          },
          {
            "key": "left_month",
            "label": "Left this month",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "{Monthly budget} - {Spent this month}"
          },
          {
            "key": "used_pct",
            "label": "Budget used (%)",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Monthly budget} > 0, ROUND({Spent this month} / {Monthly budget} * 100, 0), 0)"
          },
          {
            "key": "budget_state",
            "label": "Budget state",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Monthly budget} = 0, \"No budget\", IF({Spent this month} > {Monthly budget}, \"Over budget\", IF({Spent this month} >= {Monthly budget} * 0.8, \"Close to limit\", \"On track\")))"
          },
          {
            "key": "expense_count",
            "label": "Expenses logged",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "expenses",
            "pick": "amount",
            "agg": "count"
          }
        ],
