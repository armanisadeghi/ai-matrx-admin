        "token": "book",
        "name": "Books",
        "labelSingular": "Book",
        "labelPlural": "Books",
        "type": "entity",
        "display": "grid",
        "weight": "light",
        "ordered": false,
        "icon": "book",
        "titleField": "title",
        "describes": "Every book you want to read, are reading or have finished.",
        "subject": "thing",
        "before": [
          [
            "started_on",
            "finished_on"
          ]
        ],
