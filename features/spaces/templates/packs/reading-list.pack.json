        "fields": [
          {
            "key": "title",
            "label": "Title",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "author",
            "label": "Author",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "genre",
            "label": "Genre",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "genre",
            "relationMax": 1
          },
          {
            "key": "status",
            "label": "Status",
            "parityType": "status",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "To read",
              "Reading",
              "Finished",
              "Abandoned"
            ],
            "choiceColors": {
              "To read": "slate",
              "Reading": "blue",
              "Finished": "green",
              "Abandoned": "amber"
            },
            "default": "To read",
            "statusGroups": {
              "To read": "todo",
              "Reading": "in_progress",
              "Finished": "done",
              "Abandoned": "done"
            }
          },
          {
            "key": "rating",
            "label": "Rating (1-5)",
            "parityType": "integer",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "rules": [
              {
                "kind": "min",
                "value": 1
              },
              {
                "kind": "max",
                "value": 5
              }
            ]
          },
          {
            "key": "pages",
            "label": "Pages",
            "parityType": "integer",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "rules": [
              {
                "kind": "min",
                "value": 1
              },
              {
                "kind": "max",
                "value": 3000
              }
            ]
          },
          {
            "key": "pages_read",
            "label": "Pages read",
            "parityType": "integer",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 3000
              }
            ]
          },
          {
            "key": "pct_read",
            "label": "Read (%)",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Pages} > 0, ROUND({Pages read} / {Pages} * 100, 0), 0)"
          },
          {
            "key": "format",
            "label": "Format",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Print",
              "Ebook",
              "Audio"
            ],
            "choiceColors": {
              "Print": "slate",
              "Ebook": "blue",
              "Audio": "green"
            }
          },
          {
            "key": "started_on",
            "label": "Started",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "finished_on",
            "label": "Finished",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "review",
            "label": "Review",
            "parityType": "text",
            "sensitivity": "confidential",
            "contextPolicy": "include"
          },
          {
            "key": "logged_pages",
            "label": "Pages logged",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "sessions",
            "pick": "pages",
            "agg": "sum"
          },
          {
            "key": "minutes_read",
            "label": "Minutes logged",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "sessions",
            "pick": "minutes",
            "agg": "sum"
          },
          {
            "key": "pages_left",
            "label": "Pages left",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "{Pages} - {Pages read}",
            "source": "formula",
            "computeOn": "read"
          },
          {
            "key": "added",
            "label": "Added",
            "parityType": "created_time",
            "sensitivity": "internal",
            "contextPolicy": "include"
          }
        ],
