  "spec": {
    "specVersion": 1,
    "id": "spaces-employee-directory",
    "catalogueId": "SP0255",
    "useCase": "Gareth Pembroke coordinates operations at a twelve-person software company and uses this so everyone can find who to ask and where they work.",
    "industry": "software_it",
    "vertical": "Employee directory",
    "job": "team_hr",
    "audience": "organization",
    "teaches": "gallery",
    "strengths": [],
    "requires": [],
    "business": {
      "name": "Sandpiper Works",
      "describes": "A twelve-person software company with an Austin office and remote teammates.",
      "address": {
        "line1": "90 Emberglass Road",
        "city": "Austin",
        "region": "TX",
        "postalCode": "78701",
        "country": "US"
      },
      "phone": "(512) 555-0149",
      "website": "sandpiperworks.net",
      "email": "hello@sandpiperworks.net",
      "timezone": "America/Chicago"
    },
    "cleanupTag": "use-case:spaces-employee-directory",
    "tables": [
      {
        "token": "team",
        "name": "Teams",
        "labelSingular": "Team",
        "labelPlural": "Teams",
        "type": "entity",
        "display": "grid",
        "weight": "light",
        "ordered": false,
        "icon": "users",
        "titleField": "team_name",
        "describes": "Each team, who leads it and what it exists to do.",
        "subject": "thing",
        "fields": [
          {
            "key": "team_name",
            "label": "Team",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "lead",
            "label": "Lead",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "team_member",
            "relationMax": 1
          },
          {
            "key": "mission",
            "label": "Mission",
            "parityType": "long_text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "channel",
            "label": "Chat channel",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "member_count",
            "label": "Members",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "profile_list",
            "pick": "profile_name",
            "agg": "count",
            "filter": {
              "status": [
                "Active",
                "On leave"
              ]
            }
          }
        ],
        "rows": [
          {
            "key": "t-lead",
            "values": {
              "team_name": "Leadership",
              "lead": "tm-astrid",
              "mission": "Set direction and keep the company healthy.",
              "channel": "#leadership"
            }
          },
          {
            "key": "t-prod",
            "values": {
              "team_name": "Product",
              "lead": "tm-kofi",
              "mission": "Decide what to build next and why.",
              "channel": "#product"
            }
          },
          {
            "key": "t-eng",
            "values": {
              "team_name": "Engineering",
              "lead": "tm-bjorn",
              "mission": "Build and run the software reliably.",
              "channel": "#engineering"
            }
          },
          {
            "key": "t-care",
            "values": {
              "team_name": "Customer care",
              "lead": "tm-hana",
              "mission": "Help customers succeed within a day.",
              "channel": "#customer-care"
            }
          }
        ]
      },
      {
        "token": "profile",
        "name": "Profiles",
        "labelSingular": "Profile",
        "labelPlural": "Profiles",
        "type": "entity",
        "display": "grid",
        "weight": "light",
        "ordered": false,
        "icon": "id-card",
        "titleField": "profile_name",
        "describes": "Where each person works, who they report to, what they are good at and whether they are active.",
        "subject": "thing",
        "independentOf": {
          "team": "A person can join a team whenever they started at the company.",
          "person": "A profile exists as soon as the person is added."
        },
        "statusImplies": [],
        "fields": [
          {
            "key": "profile_name",
            "label": "Profile",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "person",
            "label": "Person",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "team_member",
            "relationMax": 1
          },
          {
            "key": "team",
            "label": "Team",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "team",
            "relationMax": 1
          },
          {
            "key": "reports_to",
            "label": "Reports to",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "profile",
            "relationMax": 1
          },
          {
            "key": "report_count",
            "label": "Direct reports",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "direct_reports",
            "pick": "profile_name",
            "agg": "count"
          },
          {
            "key": "role_type",
            "label": "Level",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "IF({Direct reports} > 0, \"Manager\", \"Individual contributor\")"
          },
          {
            "key": "location",
            "label": "Location",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Austin",
              "Remote"
            ],
            "choiceColors": {
              "Austin": "orange",
              "Remote": "teal"
            }
          },
          {
            "key": "timezone",
