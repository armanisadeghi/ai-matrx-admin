        "token": "update_profile",
        "name": "Update my profile",
        "describes": "How anyone adds their location, skills and chat link.",
        "audience": "staff",
        "table": "profile",
        "fields": [
          {
            "fieldKey": "profile_name",
            "ask": "Your name as it should appear?",
            "required": true
          },
          {
            "fieldKey": "location",
            "ask": "Where do you work from?"
          },
          {
            "fieldKey": "timezone",
            "ask": "Which time zone are you in?"
          },
          {
            "fieldKey": "skills",
            "ask": "What are you good at?"
          },
          {
            "fieldKey": "chat",
            "ask": "Link to your chat profile?"
          }
        ],
        "submitLabel": "Save",
        "confirmation": "Thanks. The directory is updated."
      }
