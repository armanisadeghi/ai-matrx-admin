      {
        "token": "color",
        "name": "Colors",
        "labelSingular": "Colour",
        "labelPlural": "Colours",
        "type": "entity",
        "display": "grid",
        "weight": "light",
        "ordered": true,
        "icon": "palette",
        "titleField": "name",
        "describes": "Every colour the product uses, light and dark, and what each is read on.",
        "subject": "thing",
        "fields": [
          {
            "key": "name",
            "label": "Name",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "group",
            "label": "Group",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Surfaces",
              "Muted",
              "Primary",
              "Lines",
              "Feedback"
            ],
            "choiceColors": {
              "Surfaces": "slate",
              "Muted": "gray",
              "Primary": "blue",
              "Lines": "teal",
              "Feedback": "red"
            }
          },
          {
            "key": "value",
            "label": "Value",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "look": {
              "id": "color_pair",
              "options": {
                "contrastWith": {
                  "readsOnField": "reads_on"
                }
              }
            }
          },
          {
            "key": "reads_on",
            "label": "Read on",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          },
          {
            "key": "usage_note",
            "label": "Usage note",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          }
        ],
        "rows": [
          {
            "key": "col-01",
            "values": {
              "name": "background",
              "group": "Surfaces",
              "value": "{\"light\":\"#ffffff\",\"dark\":\"#0b0d12\"}",
              "usage_note": "The page itself. Everything else sits on it."
            }
          },
          {
            "key": "col-02",
            "values": {
              "name": "foreground",
              "group": "Surfaces",
              "value": "{\"light\":\"#111827\",\"dark\":\"#e8ebf1\"}",
              "reads_on": "background",
              "usage_note": "Body text and icons on the page."
            }
          },
          {
            "key": "col-03",
            "values": {
              "name": "card",
              "group": "Surfaces",
              "value": "{\"light\":\"#ffffff\",\"dark\":\"#141821\"}",
              "usage_note": "Raised panels, dialogs and menus."
            }
          },
          {
            "key": "col-04",
            "values": {
              "name": "card-foreground",
              "group": "Surfaces",
              "value": "{\"light\":\"#111827\",\"dark\":\"#e8ebf1\"}",
              "reads_on": "card",
              "usage_note": "Text inside a card."
            }
          },
          {
            "key": "col-05",
            "values": {
              "name": "muted",
              "group": "Muted",
              "value": "{\"light\":\"#f1f4f8\",\"dark\":\"#1c212c\"}",
              "usage_note": "Quiet fills: table headers, empty states, code blocks."
            }
          },
          {
            "key": "col-06",
            "values": {
              "name": "muted-foreground",
              "group": "Muted",
              "value": "{\"light\":\"#5f6878\",\"dark\":\"#9aa3b5\"}",
              "reads_on": "muted",
              "usage_note": "Hints and captions on a muted fill. Check it on light."
            }
          },
          {
            "key": "col-07",
            "values": {
              "name": "primary",
              "group": "Primary",
              "value": "{\"light\":\"#2f5bea\",\"dark\":\"#6d8dff\"}",
              "usage_note": "The one main action on a screen."
            }
          },
          {
            "key": "col-08",
            "values": {
              "name": "primary-foreground",
              "group": "Primary",
              "value": "{\"light\":\"#ffffff\",\"dark\":\"#0b1230\"}",
              "reads_on": "primary",
              "usage_note": "Label on a primary button."
            }
          },
          {
            "key": "col-09",
            "values": {
              "name": "border",
              "group": "Lines",
              "value": "{\"light\":\"#e2e6ee\",\"dark\":\"#262c38\"}",
              "usage_note": "Dividers and card edges. Never text."
            }
          },
          {
            "key": "col-10",
            "values": {
              "name": "input",
              "group": "Lines",
              "value": "{\"light\":\"#646d80\",\"dark\":\"#8d97aa\"}",
              "reads_on": "card",
              "usage_note": "The outline of a field, so it is found without a label."
            }
          },
          {
            "key": "col-11",
            "values": {
              "name": "ring",
              "group": "Lines",
              "value": "{\"light\":\"#2f5bea\",\"dark\":\"#8aa4ff\"}",
              "usage_note": "Keyboard focus. Always visible, never removed."
            }
          },
          {
            "key": "col-12",
            "values": {
              "name": "destructive",
              "group": "Feedback",
              "value": "{\"light\":\"#c62828\",\"dark\":\"#f47a7a\"}",
              "reads_on": "background",
              "usage_note": "Delete and errors. Ask before anything that cannot be undone."
            }
          }
        ]
