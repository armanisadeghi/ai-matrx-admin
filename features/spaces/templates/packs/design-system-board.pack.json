          {
            "key": "usage_note",
            "label": "Usage note",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          }
        ],
        "rows": [
          {
            "key": "cmp-01",
            "values": {
              "name": "Button",
              "group": "Actions",
              "sample": "<style>.r{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.b{font:inherit;font-size:13px;font-weight:500;line-height:1;height:32px;padding:0 14px;border-radius:var(--radius);border:1px solid transparent;cursor:pointer}.p{background:var(--primary);color:var(--primary-foreground)}.p.h{filter:brightness(1.08)}.p.f{box-shadow:0 0 0 2px var(--background),0 0 0 4px var(--ring)}.p:disabled{opacity:.5;cursor:not-allowed}</style><div class=\"r\"><button class=\"b p\">Save</button><button class=\"b p h\">Hover</button><button class=\"b p f\">Focus</button><button class=\"b p\" disabled>Disabled</button></div>",
              "usage_note": "The one main action of a screen. Never two primary buttons side by side."
            }
          },
          {
            "key": "cmp-02",
            "values": {
              "name": "Button variants",
              "group": "Actions",
              "sample": "<style>.r{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.b{font:inherit;font-size:13px;font-weight:500;line-height:1;height:32px;padding:0 14px;border-radius:var(--radius);border:1px solid transparent;cursor:pointer}.s{background:var(--secondary);color:var(--secondary-foreground)}.o{background:transparent;color:var(--foreground);border-color:var(--border)}.q{background:transparent;color:var(--muted-foreground)}.d{background:var(--destructive);color:var(--destructive-foreground)}</style><div class=\"r\"><button class=\"b s\">Secondary</button><button class=\"b o\">Outline</button><button class=\"b q\">Quiet</button><button class=\"b d\">Delete</button></div>",
              "usage_note": "Outline and quiet for everything else; danger only for what cannot be undone."
            }
          },
          {
            "key": "cmp-03",
            "values": {
              "name": "Text field",
              "group": "Inputs",
              "sample": "<style>.f{display:grid;gap:6px;max-width:320px}.l{font-size:12px;font-weight:500;color:var(--foreground)}.i{font:inherit;font-size:14px;height:34px;padding:0 10px;border-radius:var(--radius);border:1px solid var(--input);background:var(--background);color:var(--foreground)}.i:focus{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 25%,transparent)}.h{font-size:12px;color:var(--muted-foreground)}.e .i{border-color:var(--destructive)}.e .h{color:var(--destructive)}.g{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}</style><div class=\"g\"><label class=\"f\"><span class=\"l\">Email</span><input class=\"i\" placeholder=\"name@company.com\"><span class=\"h\">We send the receipt here.</span></label><label class=\"f e\"><span class=\"l\">Phone</span><input class=\"i\" value=\"555-01\"><span class=\"h\">Enter all ten digits.</span></label></div>",
              "usage_note": "Label above, hint below, the error in place of the hint."
            }
          },
          {
            "key": "cmp-04",
            "values": {
              "name": "Select and search",
              "group": "Inputs",
              "sample": "<style>.g{display:flex;flex-wrap:wrap;gap:12px}.i{font:inherit;font-size:14px;height:34px;padding:0 10px;min-width:200px;border-radius:var(--radius);border:1px solid var(--input);background:var(--background);color:var(--foreground)}.s{padding-left:30px;background-image:radial-gradient(circle at 13px 16px,transparent 4px,var(--muted-foreground) 4.5px,transparent 6px)}</style><div class=\"g\"><select class=\"i\"><option>Weekly</option><option>Monthly</option></select><input class=\"i s\" placeholder=\"Search people\"></div>",
              "usage_note": "A select for a short fixed list; search when the list is long."
            }
          },
          {
            "key": "cmp-05",
            "values": {
              "name": "Card",
              "group": "Containers",
              "sample": "<style>.c{max-width:360px;padding:16px;border-radius:calc(var(--radius) * 1.5);border:1px solid var(--border);background:var(--card);color:var(--card-foreground);box-shadow:0 1px 2px #0f172a14}.t{margin:0 0 4px;font-size:15px;font-weight:600}.m{margin:0 0 12px;font-size:13px;color:var(--muted-foreground)}.a{display:flex;gap:8px}.b{font:inherit;font-size:13px;height:30px;padding:0 12px;border-radius:var(--radius);border:1px solid var(--border);background:transparent;color:var(--foreground)}.b.p{background:var(--primary);color:var(--primary-foreground);border-color:transparent}</style><div class=\"c\"><h3 class=\"t\">Quarterly report</h3><p class=\"m\">Updated 2 hours ago by Dana</p><div class=\"a\"><button class=\"b p\">Open</button><button class=\"b\">Share</button></div></div>",
              "usage_note": "One subject per card: a title, one line of detail, at most two actions."
            }
          },
          {
            "key": "cmp-06",
            "values": {
              "name": "Badge",
              "group": "Status",
              "sample": "<style>.r{display:flex;flex-wrap:wrap;gap:8px}.x{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 8px;border-radius:999px;font-size:12px;font-weight:500;border:1px solid var(--border);color:var(--foreground);background:var(--muted)}.x i{width:6px;height:6px;border-radius:50%;background:currentColor}.ok{color:var(--success)}.wa{color:var(--warning)}.er{color:var(--destructive)}.pr{background:var(--primary);color:var(--primary-foreground);border-color:transparent}</style><div class=\"r\"><span class=\"x\">Draft</span><span class=\"x pr\">New</span><span class=\"x ok\"><i></i>Live</span><span class=\"x wa\"><i></i>Waiting</span><span class=\"x er\"><i></i>Failed</span></div>",
