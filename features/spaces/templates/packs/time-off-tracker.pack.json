    "forms": [
      {
        "token": "time_off_request",
        "name": "Request time off",
        "describes": "How anyone on the team asks for days off.",
        "audience": "staff",
        "table": "request",
        "fields": [
          {
            "fieldKey": "request_name",
            "ask": "Short title for your request?",
            "required": true
          },
          {
            "fieldKey": "type",
            "ask": "What kind of leave is it?",
            "required": true
          },
          {
            "fieldKey": "start_on",
            "ask": "First day off?",
            "required": true
          },
          {
            "fieldKey": "end_on",
            "ask": "Last day off?",
            "required": true
          },
          {
            "fieldKey": "days",
            "ask": "How many working days is that?"
          },
          {
            "fieldKey": "reason",
            "ask": "Anything your manager should know?"
          }
