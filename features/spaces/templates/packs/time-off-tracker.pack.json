        "token": "request",
        "name": "Requests",
        "labelSingular": "Request",
        "labelPlural": "Requests",
        "type": "entity",
        "display": "grid",
        "weight": "light",
        "ordered": false,
        "icon": "plane",
        "titleField": "request_name",
        "describes": "Every time-off request: who, what kind, which dates and whether it was approved.",
        "subject": "thing",
        "before": [
          [
            "start_on",
            "end_on"
          ]
        ],
        "independentOf": {
          "balance": "A request can be filed for any year the person has a balance record, whenever it starts.",
          "employee": "Any employee can ask for time off whenever they joined."
        },
        "statusImplies": [
          {
            "field": "status",
            "when": [
              "Approved",
              "Declined"
            ],
            "filled": [
              "approver"
            ]
          }
        ],
        "fields": [
          {
            "key": "request_name",
            "label": "Request",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "balance",
            "label": "Balance",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "balance",
            "relationMax": 1
          },
          {
            "key": "employee",
            "label": "Employee",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "team_member",
            "relationMax": 1
          },
          {
            "key": "type",
            "label": "Type",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Vacation",
              "Sick",
              "Personal",
              "Parental",
              "Unpaid"
            ],
            "choiceColors": {
              "Vacation": "blue",
              "Sick": "red",
              "Personal": "amber",
              "Parental": "pink",
              "Unpaid": "slate"
            },
            "required": true
          },
          {
            "key": "start_on",
            "label": "Start",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "end_on",
            "label": "End",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          },
          {
            "key": "days",
            "label": "Working days",
            "parityType": "integer",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "rules": [
              {
                "kind": "min",
                "value": 1
              },
              {
                "kind": "max",
                "value": 120
              }
            ]
          },
          {
            "key": "span",
            "label": "Calendar days",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "DATEDIFF({Start}, {End}, 'days') + 1"
          },
          {
            "key": "status",
            "label": "Status",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Pending",
              "Approved",
              "Declined",
              "Cancelled"
            ],
            "choiceColors": {
              "Pending": "amber",
              "Approved": "green",
              "Declined": "red",
              "Cancelled": "slate"
            },
            "required": true,
            "default": "Pending"
          },
          {
            "key": "approver",
            "label": "Approver",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "team_member",
            "relationMax": 1
          },
          {
            "key": "reason",
            "label": "Reason",
            "parityType": "text",
            "sensitivity": "confidential",
            "contextPolicy": "summarize"
          },
          {
            "key": "submitted_on",
            "label": "Submitted",
            "parityType": "datetime",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "format": "date"
          }
        ],
