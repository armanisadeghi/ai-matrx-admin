      "icon": {
        "emoji": "📜"
      },
      "settings": {
        "fullWidth": true
      },
      "blocks": [
        {
          "type": "text",
          "text": [
            {
              "text": "The short version of how leave works. Ask the operations manager for anything not covered here."
            }
          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "Vacation"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Ask at least two weeks ahead for more than three days."
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "The clinic needs two hygienists and one dentist on every working day."
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Up to five unused days carry over until the end of March."
            }
          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "Sick leave"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Tell the front desk before the start of your shift."
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "A note is needed after three days in a row."
            }
          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "Parental and unpaid leave"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Parental leave is paid for the first eight weeks."
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Unpaid leave needs the manager and the owner to agree."
            }
          ]
        },
        {
          "type": "callout",
          "text": [
            {
              "text": "Half days count as 0.5. Enter whole working days between start and end; weekends do not count."
            }
          ],
          "background": "blue",
          "props": {
            "icon": "Info"
          }
        }
