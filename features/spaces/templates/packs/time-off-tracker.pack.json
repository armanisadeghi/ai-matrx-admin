      {
        "token": "balance",
        "name": "Balances",
        "labelSingular": "Balance",
        "labelPlural": "Balances",
        "type": "entity",
        "display": "grid",
        "weight": "light",
        "ordered": false,
        "icon": "scale",
        "titleField": "balance_name",
        "describes": "Each person's yearly allowance, days carried over and days used so far.",
        "subject": "thing",
        "fields": [
          {
            "key": "balance_name",
            "label": "Balance",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "employee",
            "label": "Employee",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "team_member",
            "relationMax": 1
          },
          {
            "key": "team",
            "label": "Team",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Clinical",
              "Front office",
              "Management"
            ],
            "choiceColors": {
              "Clinical": "teal",
              "Front office": "amber",
              "Management": "violet"
            }
          },
          {
            "key": "allowance",
            "label": "Annual allowance",
            "parityType": "integer",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 60
              }
            ]
          },
          {
            "key": "carry",
            "label": "Carry-over",
            "parityType": "integer",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "rules": [
              {
                "kind": "min",
                "value": 0
              },
              {
                "kind": "max",
                "value": 20
              }
            ]
          },
          {
            "key": "total",
            "label": "Total available",
            "parityType": "formula",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "formula": "{Annual allowance} + {Carry-over}"
          },
          {
            "key": "request_list",
            "label": "Requests",
            "parityType": "relation",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "relationTarget": "request",
            "multi": true
          },
          {
            "key": "used",
            "label": "Vacation days used",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "request_list",
            "pick": "days",
            "agg": "sum",
            "filter": {
              "status": "Approved",
              "type": "Vacation"
            }
          },
          {
            "key": "sick",
            "label": "Sick days taken",
            "parityType": "rollup",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "via": "request_list",
            "pick": "days",
            "agg": "sum",
            "filter": {
              "status": "Approved",
              "type": "Sick"
            }
          }
        ],
