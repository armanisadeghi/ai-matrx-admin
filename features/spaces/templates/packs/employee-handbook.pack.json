        "fields": [
          {
            "key": "question",
            "label": "Question",
            "parityType": "text",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "required": true
          },
          {
            "key": "category",
            "label": "Category",
            "parityType": "select",
            "sensitivity": "internal",
            "contextPolicy": "include",
            "choices": [
              "Culture",
              "Conduct",
              "Benefits",
              "Time off",
              "IT & security",
              "Finance",
              "Remote"
            ],
            "choiceColors": {
              "Culture": "blue",
              "Conduct": "green",
              "Benefits": "amber",
              "Time off": "red",
              "IT & security": "violet",
              "Finance": "teal",
              "Remote": "orange"
            }
          },
          {
            "key": "answer",
            "label": "Answer",
            "parityType": "long_text",
            "sensitivity": "internal",
            "contextPolicy": "include"
          }
        ],
        "rows": [
          {
            "key": "q1",
            "values": {
              "question": "How many vacation days do I get?",
              "category": "Time off",
              "answer": "Full-time staff receive 20 days a year, plus the public holidays on the closures page."
            }
          },
          {
            "key": "q2",
            "values": {
              "question": "When does health cover start?",
              "category": "Benefits",
              "answer": "On the first day of the month after your start date."
            }
          },
          {
            "key": "q3",
            "values": {
              "question": "Who approves my expenses?",
              "category": "Finance",
              "answer": "Your manager approves, then the finance manager pays within 10 working days."
            }
          },
          {
            "key": "q4",
            "values": {
              "question": "Can I work from home?",
              "category": "Remote",
              "answer": "Office roles can work from home two days a week by agreement with their manager."
            }
          },
          {
            "key": "q5",
            "values": {
              "question": "What if I find a safety hazard in the kitchen?",
              "category": "Conduct",
              "answer": "Stop the task, tell the kitchen supervisor, and log it in the incident notebook."
            }
          },
          {
            "key": "q6",
            "values": {
              "question": "Who do I contact about a locked account?",
              "category": "IT & security",
              "answer": "Message the IT lead in chat; never share your password."
            }
          }
        ]
      }
