      "settings": {
        "fullWidth": true
      },
      "blocks": [
        {
          "type": "text",
          "text": [
            {
              "text": "Fernhollow Foods prepares fresh meals for offices and schools across the region. Most of us work in the kitchen or on a delivery route, so this handbook is written to be read in ten minutes."
            }
          ]
        },
        {
          "type": "heading",
          "text": [
            {
              "text": "Our values"
            }
          ],
          "props": {
            "level": 2
          }
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Safe food first."
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Be on time and tell people when you cannot be."
            }
          ]
        },
        {
          "type": "bulleted",
          "text": [
            {
              "text": "Look after each other and the customer."
            }
          ]
        },
        {
          "type": "quote",
          "text": [
            {
              "text": "If you are not sure, ask. Nobody has ever been blamed for asking about food safety."
            }
          ]
        }
      ]
    },
