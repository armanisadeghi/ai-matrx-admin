  "stranded": [
   {
    "route": "/crm/admin",
    "why": "only the documentation site links to it; it is the feature's admin map",
    "proposedHome": "Admin site (not a CRM sidebar entry)"
   }
  ],
  "buried": [
   {
    "route": "/crm/chasebox",
    "depth": 2,
    "why": "the daily 'who needs a reply' view sits as a menu sub-item beside setup pages",
    "proposal": "Make Chasebox the first sidebar item under Outreach, or the CRM home card"
   },
   {
    "route": "/crm/outreach-lists/[listId]/dial",
    "depth": 3,
    "why": "phone queue is three clicks inside a list",
    "proposal": "Show a Call queue button on the list header and on the CRM home"
   }
