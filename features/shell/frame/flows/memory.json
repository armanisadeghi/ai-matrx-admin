    "buried": [
      {
        "route": "/knowledge/search",
        "depth": 2,
        "why": "The best user tool for understanding search is two clicks down and listed twice",
        "proposal": "Keep under Ask & search only; drop the Advanced copy"
      },
      {
        "route": "/exports",
        "depth": 2,
        "why": "Importing an AI history is a headline capture path but lives in Account and a hub door",
        "proposal": "Add to the Capture page doors and sidebar"
      },
      {
        "route": "/memory/my-memory",
        "depth": 2,
        "why": "The notes every agent reads sit under Everything",
        "proposal": "Give the three memory stores one front door"
      },
      {
        "route": "/suggestions",
        "depth": 2,
        "why": "AI-found links appear under Library, though people expect them under Topics or Concepts",
        "proposal": "Keep one home, link from both"
      },
      {
        "route": "/knowledge/sources/[id]",
        "depth": 3,
        "why": "The one Source screen is only reached by opening a row",
        "proposal": "Fine; make sure every result links to it"
      }
