import { live, say } from "./ba-lib.mjs";
const { browser, page, shot } = await live(false);
await page.goto("https://www.aimatrx.com/data/bases", { waitUntil: "domcontentloaded", timeout: 180000 });
await page.waitForTimeout(8000);
say("BASES", await page.locator("a[href*='/data/bases/']").evaluateAll(e=>e.slice(0,8).map(x=>x.getAttribute("href")+" "+x.innerText.replace(/\n/g," ").slice(0,50))));
const btns = await page.getByRole("button").allInnerTexts(); say("BTN", btns.filter(Boolean).slice(0,40));
await shot("wk2-conn-0");
await page.getByRole("button",{name:"New base"}).first().click();
await page.waitForTimeout(2000);
await shot("wk2-conn-1");
say("DLG", (await page.locator("[role=dialog]").allInnerTexts()).map(t=>t.replace(/\n+/g," | ").slice(0,500)));
await page.getByLabel("Name of the base").fill("WK2- Base");
await page.getByRole("button",{name:"Start empty"}).click();
await page.waitForURL(/\/data\/bases\/[0-9a-f-]{36}/,{timeout:60000}).catch(()=>{});
await page.waitForTimeout(6000);
say("URL", page.url());
await page.locator("[data-base-connection]").click({timeout:30000});
await page.waitForTimeout(3000);
await shot("wk2-conn-2");
say("DLG2", (await page.locator("[role=dialog]").allInnerTexts()).map(t=>t.replace(/\n+/g," | ").slice(0,600)));
const opts=()=>page.locator("[role=option],[role^=menuitem]");
await page.getByRole("combobox",{name:"App"}).click({timeout:10000}).catch(async()=>{ await page.locator("[data-connection-app] button").click(); });
await page.waitForTimeout(1000);
say("APPS", await opts().allInnerTexts());
await opts().filter({hasText:/asana/i}).first().click();
await page.waitForTimeout(4000);
await page.locator("[data-connection-tool] button, [data-connection-tool] [role=combobox]").first().click();
await page.waitForTimeout(1000);
say("TOOLS", (await opts().allInnerTexts()).slice(0,40));
await shot("wk2-conn-3");
process.exit(0);
