#!/bin/sh
# Versioned pre-commit hook for matrx-frontend. Activated by scripts/install_githooks.sh
# (git config core.hooksPath scripts/githooks), the same mechanism aidream already uses.
# Review before changing.
#
# TWO JOBS: (1) a migration file production has already run may not enter a commit; (2) a staged
# file may not import a name from an @ai-matrx/* package that the INSTALLED version does not ship
# (feedback fdf6b0a6: the consumer edit landed before the package was published and the shared
# dev server answered 500 on every route). (It also prints the shared-index warning below, which
# never refuses.)
# See scripts/lib/ledger-snapshot.mjs for why this is a COMMIT-time guard and not
# another release-time report.
set -u
HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HOOK_DIR/../.." && pwd)

# Setting core.hooksPath disables .git/hooks; keep any local hook of the same name running.
LOCAL_HOOK="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [ -x "$LOCAL_HOOK" ]; then
    "$LOCAL_HOOK" "$@" || exit $?
fi

# NO CONFLICT MARKERS (2026-10-22, v0.4.3443 failed on a committed `<<<<<<< HEAD`): a staged file
# holding a git conflict marker line is refused (~0.1 s, reads the index). Self-test: --self-test.
sh "$HOOK_DIR/no-conflict-markers.sh" || exit 1

# RELEASE PATH NEVER BLOCKED, AT WRITE TIME (adversarial review 2026-10-22): a staged git hook, ship.sh,
# scripts/release.sh or scripts/sync-main.py is checked by the release-path guard's static part (~0.1 s,
# read from the index; only the lines this commit adds are judged for a new non-zero exit). Commit time
# only — never on the release path (the guard is a no-op under MATRX_RELEASE_PATH=1).
RP_GUARD="$HOME/code/matrx-ship/scripts/test_release_path_never_blocked.py"
rp_files=$(git diff --cached --name-only --diff-filter=AMR | grep -E '^(scripts/githooks/[^/]+|ship\.sh|scripts/release\.sh|scripts/sync-main\.py)$')
if [ -n "$rp_files" ] && [ "${MATRX_RELEASE_PATH:-0}" != "1" ] && [ -f "$RP_GUARD" ] && command -v python3 >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    python3 "$RP_GUARD" --static --staged --repo "$ROOT" $rp_files || {
        echo "COMMIT REFUSED: this change can block the release path (above). Scream and go on, never stop a release." >&2
        exit 1
    }
fi

# SHARED-INDEX WARNING (lane GIT-OWN-COMMIT, 2026-09-23): a commit built from the shared index carries
# every lane's staged paths; this prints them (a warning, not a refusal yet). The safe way is the helper.
[ -x "$ROOT/scripts/git/commit-own-paths.sh" ] && command -v zsh >/dev/null 2>&1 && "$ROOT/scripts/git/commit-own-paths.sh" --warn-shared-index

if ! command -v node >/dev/null 2>&1; then
    echo "COMMIT REFUSED: the ledgered-migration guard needs node on PATH and could not find it." >&2
    exit 1
fi

# STAGED FILES PARSE (2026-10-22, Arman: "We need things that run when the agents are writing the code"):
# a staged .ts/.tsx/.js/.mjs whose INDEX content does not parse is refused with file:line (~0.5 s).
# Turbopack refuses it and every release build fails 7-9 min in. Never on the release path
# (MATRX_RELEASE_PATH=1 reports only). Self-test: pnpm check:parse:write-time-self-test.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs)$'; then
    (cd "$ROOT" && node scripts/check-parse.mjs --staged) || exit 1
fi

# PARTIAL COMMIT (2026-10-22, about half of 17 failed builds): a staged file may not import a LOCAL file
# or export this commit does not carry — judged against the INDEX, never the disk where the sibling sits
# (./framePageHeader, lineageSourcesOf). ~1 s. MATRX_RELEASE_PATH=1 reports only (inside the script).
# Self-test: node scripts/check-staged-imports.mjs --self-test. Temp-index commits: --index <file>.
if [ -f "$ROOT/scripts/check-staged-imports.mjs" ] && git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs)$'; then
    (cd "$ROOT" && node scripts/check-staged-imports.mjs --staged)
    SI_RC=$?
    if [ "$SI_RC" -eq 1 ]; then
        echo "COMMIT REFUSED: stage the file named above too, or remove the import — the build fails without it." >&2
        exit 1
    fi
    # exit 2 = the checker could not run: it said so above; never a refusal.
fi

# --message-file: git has not written the message yet at pre-commit, so the runner's
# receipt is what carries the exemption here (prepare-commit-msg turns it into the
# trailer that ends up in the commit). Both are the runner's, never a lane's sentence.
RECEIPT="$(git rev-parse --git-common-dir)/matrx-amend-idempotent"
node "$ROOT/scripts/check-ledgered-files-unedited.mjs" --staged --root "$ROOT" \
    --message-file "$RECEIPT" || exit $?

# JOB 2 — installed-package import guard, narrowed to the staged code files (~1s). With NO staged
# candidates it must not run at all: an empty narrowing means a full 60s scan in that script.
# A staged package.json / pnpm-lock.yaml widens the script to a full scan on its own.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mts' '*.cts' '*.js' '*.jsx' '*.mjs' package.json pnpm-lock.yaml)
if [ -n "$STAGED" ]; then
    # shellcheck disable=SC2086
    (cd "$ROOT" && printf '%s\n' "$STAGED" | xargs node scripts/check-matrx-imports.mjs --staged)
    RC=$?
    if [ "$RC" -eq 3 ]; then
        echo "COMMIT REFUSED: a package install is incomplete (see above). Wait for the install to finish, then commit again." >&2
        exit 1
    fi
    if [ "$RC" -ne 0 ]; then
        echo "COMMIT REFUSED: a staged file imports an @ai-matrx/* name the INSTALLED package does not ship." >&2
        echo "  The consumer must not land before the package. Publish the package (aidream npm train)," >&2
        echo "  then 'pnpm update \"@ai-matrx/<pkg>\" --latest', confirm 'pnpm check:matrx-imports', and commit again." >&2
        echo "  Never pin, never delete the import to go green." >&2
        exit 1
    fi
    # JOB 3 — every imported @ai-matrx package is declared in package.json (~1s, offline). An
    # undeclared one builds locally and dies "Module not found" on Vercel (v0.4.3122, 2026-10-10).
    if ! (cd "$ROOT" && node scripts/check-matrx-deps-declared.mjs --staged); then
        echo "COMMIT REFUSED: add the package(s) above to package.json as \"latest\" and commit again." >&2
        exit 1
    fi
fi
# JOB 4 — LOCKFILE-TRUE IMPORTS (2026-10-22): the staged code is judged against the @ai-matrx versions the
# STAGED pnpm-lock.yaml names — what Vercel installs — not the copies installed here, which can be newer
# (or a local build). 17 of 20 failed production builds on 2026-10-21/22 imported a name or subpath the
# LOCKED version lacked while every installed-package check was green. A staged lockfile widens the check
# to every tracked file (2026-10-21, 689c27aa4d: a lockfile-only adoption that dropped setDebrief).
# The refusal names the version that has it; the fix (pnpm sync:matrx-packages + package.json and
# pnpm-lock.yaml staged in the same commit) is in the message. MATRX_RELEASE_PATH=1 reports only.
LOCK_PATHS=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mts' '*.cts' '*.js' '*.jsx' '*.mjs' pnpm-lock.yaml package.json | xargs grep -l '@ai-matrx/' 2>/dev/null; git diff --cached --name-only -- pnpm-lock.yaml package.json)
if [ -n "$LOCK_PATHS" ]; then
    # shellcheck disable=SC2086
    if ! (cd "$ROOT" && node scripts/check-matrx-imports.mjs --lock --root "$ROOT" $(printf '%s\n' "$LOCK_PATHS" | sort -u)); then
        if [ "${MATRX_RELEASE_PATH:-0}" = "1" ]; then
            echo "  (MATRX_RELEASE_PATH=1: reported, not refused)" >&2
        else
            echo "COMMIT REFUSED: staged code imports an @ai-matrx name the LOCKED version does not ship (above) — the Vercel build fails on it." >&2
            exit 1
        fi
    fi
fi
# JOB 4b — @ai-matrx TWINS AT WRITE TIME (Arman 2026-10-21: scream when the code is written, never block the
# release). The Vercel postinstall and release.sh only REPORT twins now; this is where they are refused.
if git diff --cached --name-only -- pnpm-lock.yaml | grep -q .; then
    if ! (cd "$ROOT" && node scripts/check-matrx-packages.mjs --duplicates); then
        echo "COMMIT REFUSED: the staged pnpm-lock.yaml holds two versions of one @ai-matrx package (above). Run pnpm sync:matrx-packages and stage the lockfile again." >&2
        exit 1
    fi
fi
# CLOSE IN FLOW (Arman, 2026-10-20): a dialog's × is a flex item of its row, never pinned to a corner
# with absolute/fixed — the design-system's Dialog / Sheet / CommandDialog draw it. Runs only when a
# .tsx/.jsx is staged and the installed design-system ships the scanner (~2 s, shrink-only baseline).
CLOSE_IN_FLOW="$ROOT/node_modules/@ai-matrx/design-system/scripts/check-close-in-flow.mjs"
if [ -f "$CLOSE_IN_FLOW" ] && git diff --cached --name-only --diff-filter=ACMR -- '*.tsx' '*.jsx' | grep -q .; then
    (cd "$ROOT" && node "$CLOSE_IN_FLOW" --baseline scripts/close-in-flow-baseline.json app components features lib hooks utils providers) || {
        echo "COMMIT REFUSED: a close control is pinned to a corner (above)." >&2
        exit 1
    }
fi

# OUTBOUND REFERRAL (Arman, 2026-10-12: "make sure it never happens again"): a staged file may not add a
# raw link to a third-party site — <a target="_blank">, a literal https:// anchor, window.open, a literal
# location.href — outside @ai-matrx/kit/outbound (OutboundLink / openOutbound / withReferral). Only the
# staged code files under the app roots are scanned (~1 s); `--fix` rewrites them. Shrink-only baseline.
OUTBOUND="$ROOT/node_modules/@ai-matrx/kit/scripts/check-outbound-referral.mjs"
OUTBOUND_STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' | grep -E '^(app|components|features|lib|hooks|utils|providers|actions|config|constants|types)/' || true)
if [ -f "$OUTBOUND" ] && [ -n "$OUTBOUND_STAGED" ]; then
    # shellcheck disable=SC2086
    (cd "$ROOT" && node "$OUTBOUND" --baseline scripts/outbound-referral-baseline.json $OUTBOUND_STAGED) || {
        echo "COMMIT REFUSED: a raw outbound link (above) skips our referral data." >&2
        echo "  Fix: node node_modules/@ai-matrx/kit/scripts/check-outbound-referral.mjs --fix <file>, then stage and commit again." >&2
        exit 1
    }
fi

# ONE SUBJECT, ONE HOME (law 15, 2026-10-18): a new skill names its home (`subject:`), a synced skill
# copy is never hand-edited, a subject never gets a second home. The guard lives in common-docs beside
# this repo; a checkout without it skips this job. Only runs when a .md file is staged (~1 s).
ONE_HOME="$ROOT/../common-docs/meta/scripts/one_home.py"
if [ -f "$ONE_HOME" ] && git diff --cached --name-only | grep -q '\.md$'; then
    python3 "$ONE_HOME" --staged || {
        echo "COMMIT REFUSED: law 15, one subject one home (above)." >&2
        exit 1
    }
fi

# LINT-GUARD (Arman, 2026-10-14): a lint error on a line THIS commit changed refuses the commit — the
# agent that wrote it fixes it now, so it never reaches whoever releases next. Errors on lines the
# commit did not touch never refuse; their author's conversation is mailed (once) instead.
# The tool lives in matrx-ship (shared by every repo); a checkout without it skips this job.
LINT_GUARD="$HOME/code/matrx-ship/scripts/lint-guard.py"
if [ -f "$LINT_GUARD" ] && command -v python3 >/dev/null 2>&1; then
    python3 "$LINT_GUARD" check --repo "$ROOT" --staged || {
        echo "COMMIT REFUSED: fix the lint errors above (never disable the rule), then commit again." >&2
        exit 1
    }
fi
exit 0
