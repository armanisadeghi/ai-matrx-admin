#!/bin/sh
# Versioned prepare-commit-msg hook for matrx-frontend.
#
# JOB 1: name the conversation that made the commit (Agent-Session trailer, below).
# JOB 2: turn the receipt `pnpm db:apply --amend-idempotent` left in the git dir into
# the `amend-idempotent: <path> <sha256>` trailer on this commit, then consume it. That
# is what makes "the commit carries a trailer THE RUNNER WROTE" a mechanical fact rather
# than a sentence a lane can type: the receipt only exists because the runner proved the
# edit was keyword-only and moved the production ledger onto the new bytes.
set -u
MSG_FILE="$1"
# AGENT-SESSION TRAILER (2026-10-14): the conversation that made a commit is named in the commit, so
# lint-guard (and anyone else) can tell that conversation about a problem its code left behind.
SESSION_TRAILER=""
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then SESSION_TRAILER="Agent-Session: claude $CLAUDE_CODE_SESSION_ID"
elif [ -n "${CODEX_THREAD_ID:-}" ]; then SESSION_TRAILER="Agent-Session: codex $CODEX_THREAD_ID"
fi
if [ -n "$SESSION_TRAILER" ] && ! grep -q '^Agent-Session:' "$1"; then
    printf '\n%s\n' "$SESSION_TRAILER" >> "$1"
fi

RECEIPT="$(git rev-parse --git-common-dir)/matrx-amend-idempotent"
[ -f "$RECEIPT" ] || exit 0

while IFS= read -r line; do
    [ -n "$line" ] || continue
    grep -qF -- "$line" "$MSG_FILE" && continue
    printf '\n%s\n' "$line" >> "$MSG_FILE"
done < "$RECEIPT"

# Consumed: a receipt is good for ONE commit. Left lying around it would exempt the next
# edit to the same file, which is the whole thing this guard exists to refuse.
rm -f "$RECEIPT"
