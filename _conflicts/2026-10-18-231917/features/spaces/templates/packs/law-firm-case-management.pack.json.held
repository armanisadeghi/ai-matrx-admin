        {
          "type": "numbered",
          "text": [
            {
              "text": "Add attorneys and paralegals to the team list."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Enter every open matter with opposing party and conflict result, so future conflict checks search a complete list."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Enter every deadline on the court calendar for the next 120 days. Two people check each one."
            }
          ]
        },
        {
          "type": "numbered",
          "text": [
            {
              "text": "Start logging time daily."
            }
          ]
        },
