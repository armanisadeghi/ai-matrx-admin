/**
 * The agent situation, rendered the way the server renders it (surface declarations D4).
 *
 * A byte-for-byte port of aidream `services/conversation_context/situation.py`
 * `render_situation`: `{name}`, `{name.path}`, `{name|words when missing}`. A blank whose
 * value is missing never renders empty: its fallback words, or `(not known: <label>)`.
 * Keep the two in step — the admin preview must show what the agent receives.
 */

const BLANK_RE = /\{\s*([A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*)\s*(?:\|([^{}]*))?\}/g;
export const MAX_BLANK_CHARS = 600;
const ENVELOPE_KEYS = new Set([
  "content",
  "label",
  "description",
  "type",
  "max_inline_chars",
  "value",
  "__kind_hint",
]);

function isPlainObject(v: unknown): v is Record<string, unknown> {
  return typeof v === "object" && v !== null && !Array.isArray(v);
}

function unwrap(value: unknown): unknown {
  let current = value;
  for (let i = 0; i < 4; i++) {
    if (isPlainObject(current)) {
      const keys = Object.keys(current);
      if (keys.length > 0 && keys.every((k) => ENVELOPE_KEYS.has(k))) {
        if ("content" in current) {
          current = current.content;
          continue;
        }
        if ("value" in current) {
          current = current.value;
          continue;
        }
      }
    }
    break;
  }
  return current;
}

function lookup(values: Record<string, unknown>, dotted: string): unknown {
  const [head, ...rest] = dotted.split(".");
  let current = unwrap(values[head]);
  for (const part of rest) {
    current = unwrap(current);
    if (isPlainObject(current)) current = current[part];
    else return undefined;
  }
  return unwrap(current);
}

function isMissing(value: unknown): boolean {
  if (value === null || value === undefined) return true;
  if (typeof value === "string" && !value.trim()) return true;
  if (Array.isArray(value) && value.length === 0) return true;
  if (isPlainObject(value) && Object.keys(value).length === 0) return true;
  return false;
}

function cut(text: string, limit: number): string {
  const flat = text.split(/\s+/).filter(Boolean).join(" ");
  return flat.length <= limit ? flat : `${flat.slice(0, limit - 1).trimEnd()}…`;
}

/** One value as words: yes/no, numbers plain, short scalar lists joined, else compact JSON. */
export function formatSituationValue(value: unknown, limit = MAX_BLANK_CHARS): string {
  if (typeof value === "boolean") return value ? "yes" : "no";
  if (typeof value === "number") return String(value);
  if (typeof value === "string") return cut(value, limit);
  if (Array.isArray(value)) {
    if (value.every((v) => typeof v === "string" || typeof v === "number")) {
      return cut(value.map((v) => formatSituationValue(v, limit)).join(", "), limit);
    }
    return `${value.length} items`;
  }
  try {
    return cut(JSON.stringify(value), limit);
  } catch {
    return cut(String(value), limit);
  }
}

function missingWords(name: string, labels: Record<string, string>): string {
  const parts = name.split(".");
  const last = parts[parts.length - 1].replace(/_/g, " ");
  let label = labels[parts[0]] || last;
  if (parts.length > 1) label = `${label} ${last}`;
  return `(not known: ${label.toLowerCase()})`;
}

/** Fill every blank in `template` from `values`; never leaves a blank empty. */
export function renderSituation(
  template: string,
  values: Record<string, unknown>,
  labels: Record<string, string> = {},
): string {
  return template.trim().replace(BLANK_RE, (_m, name: string, fallback?: string) => {
    const value = lookup(values, name);
    if (isMissing(value)) {
      if (fallback !== undefined && fallback.trim()) return fallback.trim();
      return missingWords(name, labels);
    }
    return formatSituationValue(value);
  });
}

/** The value names a template's blanks read (first segment of each dotted name), in order. */
export function situationBlankNames(template: string): string[] {
  const names: string[] = [];
  for (const m of template.matchAll(BLANK_RE)) {
    const head = m[1].split(".")[0];
    if (!names.includes(head)) names.push(head);
  }
  return names;
}

/**
 * Values to preview a situation with, from the latest probe. A probe that recorded values
 * (`last_check.values`) gives them as they were; one that recorded only which keys arrived
 * (`suppliedValues`, every probe today) stands each in as `[Label]`, so the preview shows
 * which blanks would fill and which fall back. Keys supplied empty stay missing.
 */
export function probePreviewValues(
  probe: { values?: Record<string, unknown> | null; suppliedValues?: string[]; suppliedEmpty?: string[] } | null,
  labels: Record<string, string>,
): { values: Record<string, unknown>; source: "probe-values" | "probe-keys" | "none" } {
  if (!probe) return { values: {}, source: "none" };
  if (probe.values && isPlainObject(probe.values) && Object.keys(probe.values).length > 0) {
    return { values: probe.values, source: "probe-values" };
  }
  const supplied = probe.suppliedValues ?? [];
  if (supplied.length === 0) return { values: {}, source: "none" };
  const empty = new Set(probe.suppliedEmpty ?? []);
  const values: Record<string, unknown> = {};
  for (const key of supplied) {
    if (empty.has(key)) continue;
    values[key] = `[${labels[key] || key.replace(/_/g, " ")}]`;
  }
  return { values, source: "probe-keys" };
}
